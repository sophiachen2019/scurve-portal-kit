{
  "name": "@scurve/portal-kit",
  "version": "0.2.0",
  "description": "Shared design tokens, API client, and UX primitives for S-Curve Data agent platform portals.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sophiachen2019/scurve-portal-kit.git"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "files": [
    "dist",
    "src",
    "tokens.css"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "verify": "tsc && node scripts/verify.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "sideEffects": [
    "*.css"
  ]
}
